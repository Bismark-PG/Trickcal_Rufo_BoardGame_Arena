# Rufo BoardGame Arena - Environment Variables Template
# Copy this file to `.env` and fill in your private Discord Webhook URLs.

# Discord 4-Channel Webhooks (Keep secret in .env only)
DISCORD_WEBHOOK_ERROR=
DISCORD_WEBHOOK_STATS=
DISCORD_WEBHOOK_BUG=
DISCORD_WEBHOOK_SUGGESTION=

# Optional Server Flags
PORT=3000
HOST=0.0.0.0
VERIFY_WS_ORIGIN=true
TRUST_PROXY=false
ALLOW_EXTERNAL_LOG_API=false
ALLOW_MULTI_TAB_TEST=false
DISCORD_STATS_TEST_ON_BOOT=false
